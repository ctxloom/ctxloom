# Default agent-image BASE: the shared stage-1 of every locally-built agent
# image (tagged ctxloom-agent-base:latest). The per-engine Containerfiles under
# container/production/ layer the agent specifics — engine CLI install, the
# ctxloom binary, the build gates — onto this via ARG BASE_IMAGE, so the base is
# the ONE place the common environment lives (DRY), and the one thing a user
# replaces to bring their own: point isolation_base_containerfile (config) or
# `ctxloom container build --base-containerfile` at a Containerfile and the same
# agent layers build on top of it instead.
#
# node:22-slim is the default: Debian (apt — the engine layers' install contract)
# with a current node runtime, which the claude layer's npm install needs anyway.
# A user base must keep that contract: Debian-family with apt, plus node/npm for
# claude-backed images (the in-image build gates fail fast when it doesn't).
#
# The tool layer is the coding-agent baseline the engines expect at RUN time:
# git (repo operations, worktree-in-container), ripgrep (claude's Grep tool —
# the CLI no longer vendors its own), curl + ca-certificates (fetches, the kiro
# installer), unzip (installer archives), jq (ubiquitous in hook scripts),
# strace (the read-observation isolation probe wraps the engine exec in it —
# harmless without CAP_SYS_PTRACE, which only the probe run grants),
# python3 (the runtime serena's MCP server needs; see the serena layer below).
FROM node:22-slim

# Default TERM so interactive agent runs get color/ANSI. The runtime starts
# processes with a bare environment, leaving TERM=dumb, which makes every CLI
# (git, ripgrep, the engine itself) strip color and cursor control. A sane
# 256-color default restores it; the isolation runtime can still override TERM
# per run when the host terminal reports something richer or poorer.
ENV TERM=xterm-256color \
    COLORTERM=truecolor

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git ripgrep curl ca-certificates unzip jq strace python3 \
    && rm -rf /var/lib/apt/lists/*

# serena — the code-intelligence MCP server (find_symbol,
# find_referencing_symbols, the symbol-edit tools). It ships in the BASE, not in
# one engine layer, because a container-bound agent cannot see a host-installed
# serena and loses those tools SILENTLY: it does not know they are missing and
# falls back to grep. uv is copied from its own published image rather than
# curl-piped, so the installer version is pinned the way the FROM tag is;
# serena-agent itself is unpinned, matching the engine layers' `npm install -g`
# (always-current tool, no lockstep with this file).
COPY --from=ghcr.io/astral-sh/uv:0.9.22 /uv /usr/local/bin/uv

# The tool venv and its shims go under /opt + /usr/local/bin, NOT root's home:
# the entrypoint remaps the run user (PUID/PGID), so anything installed into
# /root would be unreachable by the process that actually runs the engine.
ENV UV_TOOL_DIR=/opt/uv/tools \
    UV_TOOL_BIN_DIR=/usr/local/bin

# UV_NO_CACHE: the download/build cache is worth ~40MB of image for wheels
# nothing in the image will install again. The gate is `serena --help`, which
# imports the package and exits 0 — a shim that merely EXISTS proves nothing.
RUN UV_NO_CACHE=1 uv tool install --python python3 serena-agent \
    && serena --help >/dev/null
