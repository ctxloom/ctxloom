{
  "name": "postgres",
  "found": true,
  "entries": [
    {
      "name": "postgres",
      "command": "mcp-postgres",
      "args": [
        "--readonly"
      ],
      "env": {
        "PGDATABASE": "app",
        "PGHOST": "localhost",
        "PGPORT": "5432"
      },
      "source": "ctxloom+local:code-quality",
      "notes": "Read-only connection to the app database.",
      "installation": "brew install mcp-postgres"
    }
  ]
}