{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "ctxloom hook stamp-plan",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "ltk evaluate",
            "type": "command"
          }
        ],
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "ctxloom hook session-bind",
            "type": "command"
          },
          {
            "command": "'/home/babbitt/go/bin/ctxloom' hook inject-context --project '/home/babbitt/workspace/ctxloom/ctxloom/main' --part 1 --of 3 e698b561eecad23a",
            "timeout": 60,
            "type": "command"
          },
          {
            "command": "'/home/babbitt/go/bin/ctxloom' hook inject-context --project '/home/babbitt/workspace/ctxloom/ctxloom/main' --part 2 --of 3 e698b561eecad23a",
            "timeout": 60,
            "type": "command"
          },
          {
            "command": "'/home/babbitt/go/bin/ctxloom' hook inject-context --project '/home/babbitt/workspace/ctxloom/ctxloom/main' --part 3 --of 3 e698b561eecad23a",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "command": "/home/babbitt/go/bin/ctxloom hook hud",
    "type": "command"
  }
}
