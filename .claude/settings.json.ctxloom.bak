{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "ctxloom tasks stamp-plan"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ctxloom session bind"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ctxloom meta hud"
  }
}