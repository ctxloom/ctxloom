tasks-run-not-found = task not found: { $harp_id }
tasks-run-not-interactive = no task harp id given and not a terminal; pass a task harp id (see `taskloom list`)
tasks-run-read-selection = read task selection: { $detail }
tasks-run-no-ctxloom = taskloom run requires ctxloom on PATH to launch the agent session (https://github.com/ctxloom/ctxloom); all other taskloom commands work without it
tasks-run-exited = ctxloom run exited with status { $status }
tasks-run-launch = ctxloom run: { $detail }
tasks-run-cancelled = cancelled
