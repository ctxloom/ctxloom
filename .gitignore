# Binaries
/ctxloom
bin/
scm-linux-amd64
scm-darwin-amd64
scm-darwin-arm64
scm-windows-amd64.exe

# Generated man pages
man/

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work
go.work.sum

# Generated protobuf (source .proto files are kept)
*.pb.go

# Local config
.ctxloom/*
# ...but keep the consolidation/design plans under version control
!.ctxloom/plans/
# Defense-in-depth: a NESTED .ctxloom under a package dir is test/tool pollution
# (the root `.ctxloom/*` above is anchored by its slash, so nested dirs slip
# through). The operations TestMain also prevents + guards this at its source.
internal/**/.ctxloom/
.mcp.json
.tasks/

# IDE
.idea/
*.swp
*.swo
*~
.vscode/

# OS
.DS_Store
Thumbs.db

# Coverage
coverage.out
coverage.html

# Debug
__debug_bin*

# Plan files
.plan/
internal/memory/vectordb/onnxlib/libonnxruntime.so
internal/memory/vectordb/onnxlib/onnxruntime.dll
internal/memory/vectordb/onnxlib/libonnxruntime.dylib
coverage.html
coverage.raw.out
.cache/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# ctxloom ephemeral data (synced bundles, session data, context files)
.ctxloom/ephemeral/

# ctxloom private working state (synced bundles, session/context, project id)
*.ctxloom.bak
.gemini/

# Generated JSON Schemas for ctxloom JSON output (vexed-cloak); produced by
# `just gen-schemas` (build dep + CI step), like generated protobuf.
resources/schema/gen/

# ctxloom private working state (synced bundles, session/context, project id)
