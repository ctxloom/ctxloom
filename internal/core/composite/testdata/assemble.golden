    {
      "AllowedTools": null,
      "ArgumentHint": "",
      "Content": "blob:8c31ad9321fdae7d965185978ec41cf97d56dbd20eab7f21616a44aba8a9be1f",
      "Description": "",
      "Enabled": true,
      "Model": "",
      "Name": "ctxloom-init"
    },
    {
      "AllowedTools": null,
      "ArgumentHint": "",
      "Content": "blob:250eb05176d8be60b056237eb4d1ccf42ef1492fa060c8b2db31b1349f23abb4",
      "Description": "",
      "Enabled": true,
      "Model": "",
      "Name": "discover"
    },
    {
      "AllowedTools": null,
      "ArgumentHint": "",
      "Content": "Review the staged diff.\n",
      "Description": "",
      "Enabled": true,
      "Model": "",
      "Name": "code-quality/review"
    },
    {
      "AllowedTools": null,
      "ArgumentHint": "",
      "Content": "Prepare the release notes.",
      "Description": "",
      "Enabled": true,
      "Model": "",
      "Name": "premised/release"
    }
  ],
  "DenyTools": [
    "Task"
  ],
  "Hooks": {
    "unified": {
      "post_tool": [
        {
          "args": [
            "hook",
            "tool-reflect",
            "--min-output-bytes",
            "2048"
          ],
          "command": "ctxloom",
          "timeout": 5,
          "type": "command"
        },
        {
          "args": [
            "hook",
            "skill-mates"
          ],
          "command": "ctxloom",
          "matcher": "Skill",
          "timeout": 15,
          "type": "command"
        }
      ],
      "pre_tool": [
        {
          "_ctxloom": "bundle:ctxloom+local:code-quality",
          "async": true,
          "command": "audit-log record",
          "matcher": "Write",
          "type": "command"
        },
        {
          "_ctxloom": "bundle:ctxloom+local:code-quality",
          "command": "ltk guard",
          "matcher": "Bash",
          "timeout": 30,
          "type": "command"
        }
      ],
      "session_start": [
        {
          "_ctxloom": "bundle:ctxloom+local:code-quality",
          "pre_tool_fallback": true,
          "prompt": "Load the project context.",
          "type": "prompt"
        }
      ],
      "turn_end": [
        {
          "args": [
            "hook",
            "next-step"
          ],
          "command": "ctxloom",
          "timeout": 15,
          "type": "command"
        }
      ],
      "turn_start": [
        {
          "args": [
            "hook",
            "mail-drain"
          ],
          "command": "ctxloom",
          "timeout": 5,
          "type": "command"
        }
      ]
    }
  },
  "ManageStatusline": true,
  "Skills": [
    {
      "Description": "Review a change against the project's review checklist.",
      "Enabled": true,
      "Files": [
        {
          "Content": "blob:235fd9e4746922c1dbb12eaca3acf2420e5a14d24ebc209494c3f8bbc87b0747",
