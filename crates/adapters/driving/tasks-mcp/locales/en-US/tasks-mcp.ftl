tasks-mcp-arguments = invalid arguments to { $tool }: { $detail }
tasks-mcp-unknown-tool = no tool is named { $name }
tasks-mcp-unknown-resource = no resource is at { $uri }
tasks-mcp-crashed = the call stopped before it answered: { $detail }
tasks-mcp-serve = the MCP server stopped: { $detail }
tasks-mcp-no-project = no project here yet: nothing to list
tasks-mcp-every-project = no project here: { $directory } is in no git repository, has no CTXLOOM_ROOT and no project of its own, so this reads every project; pass --project <id>, or work in a project, to read one
