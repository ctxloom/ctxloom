# Container justfile - runs inside devcontainer with CGO dependencies
# This file is mounted over justfile when running via `just dev-*` targets
#
# Build modes:
# - Static builds: no CGO features
# - CGO builds: treesitter (CGO but static-linkable)

# Containers build in plain module mode: github.com/ctxloom/* come from the
# go.mod pins (module cache/proxy), never from a host go.work or sibling
# checkouts. Push sibling changes and bump the pin to pick them up here.
export GOWORK := "off"

# Per-binary build justfiles, composed here via `mod`. Each lives next to its
# code, owns that binary's build/compress, and shares the common build logic via
# `import "build/common.justfile"`. Their recipes are reachable as
# ctxloom::build, ltk::build, taskloom::build, etc.
mod ctxloom "cmd/ctxloom/justfile"
mod ltk "cmd/ltk/justfile"
mod taskloom "cmd/taskloom/justfile"

# Get version from versionator (with fallback). Standardized stamp:
#   v<major.minor.patch>-<short-sha>-<YYYYMMDDTHHMMSS commit datetime, utc>
# versionator emits the compact datetime (no separator); sed inserts the 'T'.
version := `if v=$(versionator output version -t "{{Prefix}}{{MajorMinorPatch}}-{{ShortHash}}-{{CommitDateCompact}}" --prefix 2>/dev/null); then echo "$v" | sed -E 's/([0-9]{8})([0-9]{6})$/\1T\2/'; else echo dev; fi`

# Static linking flags for builds that support it
static_ldflags := "-linkmode external -extldflags '-static -pthread'"

# Disable VCS stamping (git may not work inside container)
buildvcs := "-buildvcs=false"

# Trimpath for reproducible builds and smaller binaries
trimpath := "-trimpath"

# Default recipe
default: build

# ===== Build targets =====

# Build ctxloom with all features (treesitter). Codegen prerequisites run here
# (the ctxloom module can't depend on these container-level recipes), then the
# actual go build is delegated to the ctxloom module (cmd/ctxloom/justfile).
build: validate proto gen-schemas gen-docs
    just ctxloom::build

# Build without CGO - static
build-static:
    CGO_ENABLED=0 go build {{buildvcs}} {{trimpath}} \
        -ldflags "-s -w -X github.com/ctxloom/ctxloom/internal/cli.Version={{version}}" \
        -o ctxloom ./cmd/ctxloom

# Build with tree-sitter code compression - static linked
build-treesitter:
    CGO_ENABLED=1 go build {{buildvcs}} {{trimpath}} -tags "treesitter" \
        -ldflags "-s -w -X github.com/ctxloom/ctxloom/internal/cli.Version={{version}} {{static_ldflags}}" \
        -o ctxloom ./cmd/ctxloom

# Build with all CGO features
build-full: validate proto
    CGO_ENABLED=1 go build {{buildvcs}} {{trimpath}} -tags "treesitter" \
        -ldflags "-s -w -X github.com/ctxloom/ctxloom/internal/cli.Version={{version}}" \
        -o ctxloom ./cmd/ctxloom

# Build the ltk companion into bin/ltk — delegated to the ltk module
# (cmd/ltk/justfile). No codegen prerequisites (pure-Go, no CGO).
build-ltk:
    just ltk::build

# Build the taskloom companion into bin/taskloom — delegated to the taskloom
# module (cmd/taskloom/justfile). No codegen prerequisites (pure-Go, no CGO).
build-taskloom:
    just taskloom::build

# Build + compress all three binaries (UPX). Codegen prerequisites run here for
# ctxloom, then each module's build-compressed builds and UPX-compresses its
# binary. Used by the host `install`/`build-compressed`.
build-compressed: validate proto gen-schemas
    just ctxloom::build-compressed
    just ltk::build-compressed
    just taskloom::build-compressed

# ===== Cross-compilation targets =====

# Build for Linux amd64
build-linux-amd64:
    GOOS=linux GOARCH=amd64 CGO_ENABLED=0 \
        go build {{buildvcs}} {{trimpath}} \
        -ldflags "-s -w -X github.com/ctxloom/ctxloom/internal/cli.Version={{version}}" \
        -o ctxloom-linux-amd64 ./cmd/ctxloom

# Build for Linux arm64
build-linux-arm64:
    GOOS=linux GOARCH=arm64 CGO_ENABLED=0 \
        go build {{buildvcs}} {{trimpath}} \
        -ldflags "-s -w -X github.com/ctxloom/ctxloom/internal/cli.Version={{version}}" \
        -o ctxloom-linux-arm64 ./cmd/ctxloom

# Build for Windows amd64
build-windows-amd64:
    GOOS=windows GOARCH=amd64 CGO_ENABLED=0 \
        go build {{buildvcs}} {{trimpath}} \
        -ldflags "-s -w -X github.com/ctxloom/ctxloom/internal/cli.Version={{version}}" \
        -o ctxloom-windows-amd64.exe ./cmd/ctxloom

# Build for macOS amd64
build-darwin-amd64:
    GOOS=darwin GOARCH=amd64 CGO_ENABLED=0 \
        go build {{buildvcs}} {{trimpath}} \
        -ldflags "-s -w -X github.com/ctxloom/ctxloom/internal/cli.Version={{version}}" \
        -o ctxloom-darwin-amd64 ./cmd/ctxloom

# Build for macOS arm64
build-darwin-arm64:
    GOOS=darwin GOARCH=arm64 CGO_ENABLED=0 \
        go build {{buildvcs}} {{trimpath}} \
        -ldflags "-s -w -X github.com/ctxloom/ctxloom/internal/cli.Version={{version}}" \
        -o ctxloom-darwin-arm64 ./cmd/ctxloom

# Build all platforms
build-all: build-linux-amd64 build-linux-arm64 build-windows-amd64 build-darwin-amd64 build-darwin-arm64

# ===== UPX Compression =====

# Compress Linux amd64 binary with UPX
compress-linux-amd64:
    upx --best --lzma ctxloom-linux-amd64

# Compress Linux arm64 binary with UPX
compress-linux-arm64:
    upx --best --lzma ctxloom-linux-arm64

# Compress Windows binary with UPX
compress-windows-amd64:
    upx --best --lzma ctxloom-windows-amd64.exe

# Note: UPX doesn't support macOS binaries well (code signing issues)
# macOS binaries are not compressed

# Compress all compressible binaries
compress-all: compress-linux-amd64 compress-linux-arm64 compress-windows-amd64

# Compress the main ctxloom binary (for local dev) — delegated to the ctxloom
# module. For all three binaries use `build-compressed`.
compress:
    just ctxloom::compress

# Build and compress all platforms
release: build-all compress-all

# ===== Testing =====

# Run tests. Coverage is filtered through .coverignore so the number CI uploads
# to Codecov excludes generated files (protobuf, gRPC) — matching the host
# justfile `test` recipe instead of reporting a raw, generated-file-diluted figure.
test:
    #!/usr/bin/env bash
    set -e
    go test -race -coverprofile=coverage.raw.out ./...
    just -f justfile.container _filter_coverage coverage.raw.out coverage.out
    rm -f coverage.raw.out

# Filter coverage output using patterns from .coverignore (mirrors the host
# justfile so local and CI coverage are computed identically).
# Usage: _filter_coverage <input> <output>
_filter_coverage INPUT OUTPUT:
    #!/usr/bin/env bash
    set -e
    if [ -f .coverignore ]; then
        # Build grep pattern from .coverignore (skip comments and empty lines)
        patterns=$(grep -v '^#' .coverignore | grep -v '^$' | paste -sd '|' -)
        if [ -n "$patterns" ]; then
            grep -Ev "$patterns" "{{INPUT}}" > "{{OUTPUT}}" || cp "{{INPUT}}" "{{OUTPUT}}"
            exit 0
        fi
    fi
    cp "{{INPUT}}" "{{OUTPUT}}"

# Run tests with the treesitter (CGO) build tag — exercises the code compressor
test-treesitter:
    CGO_ENABLED=1 go test -race -tags treesitter ./internal/compression/...

# Run a single package's tests under -race (fast iteration inside the container)
test-pkg PKG *ARGS:
    go test -race {{ARGS}} {{PKG}}

# Run integration tests (requires ctxloom binary)
test-integration: build
    go test -v -tags integration ./tests/integration/...

# Run the full-stack acceptance suite (godog) inside the container. Hermetic by
# default; @live scenarios are opt-in and self-skip without credentials.
test-acceptance: build
    go test -tags "acceptance integration" -count=1 ./tests/acceptance/...

# ===== Validation =====

# Validate fragment YAML files
validate:
    go run ./cmd/validate

# Generate protobuf code
proto:
    buf generate

# Lint code
lint:
    golangci-lint run

# Regenerate the published JSON Schemas for ctxloom's JSON output into the
# gitignored resources/schema/gen/ by reflecting their producing Go structs.
# A generated build artifact (like protobuf): a `build` dependency and a CI
# step, not checked in. Build-tagged `schemagen` so the reflection dependency
# never enters the production binary.
gen-schemas:
    go run -tags schemagen ./cmd/gen-schemas

# Generate CLI docs (man pages + website markdown) from the command tree.
# The cobra command definitions in internal/cli are the single source of
# truth; the website pages are checked in, the man pages are gitignored
# release artifacts.
gen-docs:
    go run ./scripts/gendocs --man man/man1 --markdown website/src/content/docs/reference/cli

# Drift gate: regenerate the CLI docs and fail if the checked-in website pages
# no longer match the command definitions. man/man1 is gitignored, so only the
# website directory is diffed. Run in the CI lint job.
gen-docs-check: gen-docs
    git diff --exit-code -- website/src/content/docs/reference/cli

# Per-function cyclomatic complexity (lizard) — human-readable table + warnings.
# Defaults to repo root; pass paths/flags to scope. Leading `-` ignores lizard's
# non-zero exit when functions exceed the threshold, so this stays a report.
complexity *ARGS:
    -lizard -x "*.pb.go" -x "*/website/*" {{ if ARGS == "" { "." } else { ARGS } }}

# Per-function complexity as CSV (header prepended) for LLM/tooling ingest.
# Columns: nloc,ccn,tokens,params,length,location,file,function,long_name,start,end
complexity-csv *ARGS:
    #!/usr/bin/env bash
    set -uo pipefail
    echo "nloc,ccn,tokens,params,length,location,file,function,long_name,start,end"
    lizard -x "*.pb.go" -x "*/website/*" --csv {{ if ARGS == "" { "." } else { ARGS } }} || true

# Enforcing gate: fail if any function exceeds CCN 10. No leading `-`, so a
# violation propagates lizard's non-zero exit and breaks CI. Run in the lint
# job alongside golangci-lint.
complexity-check *ARGS:
    lizard -x "*.pb.go" -x "*/website/*" -C 10 {{ if ARGS == "" { "." } else { ARGS } }}

# Format code
fmt:
    go fmt ./...

# Tidy dependencies
tidy:
    go mod tidy
