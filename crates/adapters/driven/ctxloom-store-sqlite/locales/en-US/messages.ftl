# Messages for the crate's errors. Each id is an error's code, which begins
# with the crate's name; the variables are its args.

ctxloom-store-sqlite-create-dir = cannot make the directory { $path }: { $ext_err_txt }
ctxloom-store-sqlite-unplaced = cannot place the database { $path } on disk: { $ext_err_txt }
ctxloom-store-sqlite-open = cannot open the database { $path }: { $ext_err_txt }
