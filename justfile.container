# Container justfile - runs inside devcontainer with CGO dependencies
# This file is mounted over justfile when running via `just dev-*` targets
#
# Build modes:
# - Static builds: no CGO features
# - CGO builds: treesitter (CGO but static-linkable)
#
# test-pkg below takes PKG/*ARGS and forwards them to `go test`; this hands
# them to its shebang script as real shell positional args ($1, "$@")
# instead of splicing them into the recipe body as text — see the host
# justfile's matching setting/comment for the failure mode this avoids.
set positional-arguments := true

# Gates that MUST be identical here and in the host justfile:
# test-docker-integration (and its package list), test-arch, plus the
# generated-protobuf precondition. Imported, not duplicated — this file used
# to carry its own shorter copy of test-docker-integration under the same name, and since CI
# runs THIS file, the packages the host copy listed never ran there.
import "build/gates.justfile"

# Every CI step, as a recipe — see build/ci.justfile. Imported here as well as
# in the host justfile because the containerized CI jobs set
# JUST_JUSTFILE=justfile.container and then call these by bare name.
import "build/ci.justfile"

# Containers build in plain module mode: github.com/ctxloom/* come from the
# go.mod pins (module cache/proxy), never from a host go.work or sibling
# checkouts. Push sibling changes and bump the pin to pick them up here.
export GOWORK := "off"

# Per-binary build justfiles, composed here via `mod`. Each lives next to its
# code, owns that binary's build/compress, and shares the common build logic via
# `import "build/common.justfile"`. Their recipes are reachable as
# ctxloom::build, ltk::build, taskloom::build, etc.
#
# Recipes below invoke these as `just -f justfile.container <mod>::<recipe>`,
# and the `-f` is LOAD-BEARING — a bare `just ctxloom::build` is broken and was
# broken in CI. just does not export JUST_JUSTFILE to a recipe's environment,
# so a nested bare `just` searches for a justfile from scratch and finds the
# HOST `justfile`, which declares none of these modules:
#
#   error: Justfile does not contain submodule `ctxloom`
#
# It looked fine for as long as it did because the local path never takes it:
# `just dev-*` mounts THIS file over `justfile` inside the container (the host
# justfile's `_run` overlay), so there the bare call resolves to this file and
# the modules are there. CI does not mount anything — it runs
# `just -f justfile.container build` against a checkout holding both files —
# so only CI hit the broken resolution, and only in a job that a red upstream
# job had been skipping.
mod ctxloom "cmd/ctxloom/justfile"
mod ltk "cmd/ltk/justfile"
mod taskloom "cmd/taskloom/justfile"
mod harp "cmd/harp/justfile"

# Get version from versionator (with fallback). Standardized stamp:
#   v<major.minor.patch>-<short-sha>-<YYYYMMDDTHHMMSS commit datetime, utc>
# versionator emits the compact datetime (no separator); sed inserts the 'T'.
version := `if v=$(versionator output version -t "{{Prefix}}{{MajorMinorPatch}}-{{ShortHash}}-{{BuildDateTimeCompact}}" --prefix 2>/dev/null); then v=$(echo "$v" | sed -E 's/([0-9]{8})([0-9]{6})$/\1T\2/'); d=$(versionator output version -t "{{Dirty}}" 2>/dev/null); if [ -n "$d" ]; then echo "$v-dirty"; else echo "$v"; fi; else echo dev; fi`

# Static linking flags for builds that support it
static_ldflags := "-linkmode external -extldflags '-static -pthread'"

# Disable VCS stamping (git may not work inside container)
buildvcs := "-buildvcs=false"

# Trimpath for reproducible builds and smaller binaries
trimpath := "-trimpath"

# Default recipe
default: build

# ===== Build targets =====

# Build ctxloom with all features (treesitter). Codegen prerequisites run here
# (the ctxloom module can't depend on these container-level recipes), then the
# actual go build is delegated to the ctxloom module (cmd/ctxloom/justfile).
#
# Deliberately does NOT depend on gen-docs (keen-name): proto/gen-schemas
# regenerate gitignored derived artifacts the compile itself needs (pb.go,
# resources/schema/gen/), but gen-docs overwrites COMMITTED website pages —
# nothing this binary needs to compile — so bundling it here meant every
# plain `just build` (and therefore `just test`, which depends on build)
# silently dirtied the tree with doc drift, training everyone to ignore
# dirty state. release-snapshot already omits it for the same reason.
# Freshness is now a gate, not a side effect: `just gen-docs-check` /
# `.github/workflows/ci.yml`'s "Check generated reference docs are current"
# step regenerates and fails the build on any diff instead.
build: validate proto gen-schemas
    just -f justfile.container ctxloom::build

# Coverage-instrumented ctxloom, to ctxloom-cover. Same codegen prerequisites
# as `build` — a binary built against stale generated code would report
# coverage of code that is not what the suite compiled against.
build-cover: validate proto gen-schemas
    just -f justfile.container ctxloom::build-cover

# Build without CGO - static
build-static:
    CGO_ENABLED=0 go build {{buildvcs}} {{trimpath}} \
        -ldflags "-s -w -X github.com/ctxloom/ctxloom/internal/version.Version={{version}}" \
        -o ctxloom ./cmd/ctxloom

# Build with tree-sitter code compression - static linked
build-treesitter:
    CGO_ENABLED=1 go build {{buildvcs}} {{trimpath}} -tags "treesitter" \
        -ldflags "-s -w -X github.com/ctxloom/ctxloom/internal/version.Version={{version}} {{static_ldflags}}" \
        -o ctxloom ./cmd/ctxloom

# Build with all CGO features
build-full: validate proto
    CGO_ENABLED=1 go build {{buildvcs}} {{trimpath}} -tags "treesitter" \
        -ldflags "-s -w -X github.com/ctxloom/ctxloom/internal/version.Version={{version}}" \
        -o ctxloom ./cmd/ctxloom

# Build the ltk companion into bin/ltk — delegated to the ltk module
# (cmd/ltk/justfile). No codegen prerequisites (pure-Go, no CGO).
build-ltk:
    just -f justfile.container ltk::build

# Build the taskloom companion into bin/taskloom — delegated to the taskloom
# module (cmd/taskloom/justfile). No codegen prerequisites (pure-Go, no CGO).
build-taskloom:
    just -f justfile.container taskloom::build

# Build the standalone harp ID-generator binary into bin/harp — delegated to
# the harp module (cmd/harp/justfile). No codegen prerequisites (pure-Go, no
# CGO). Independently distributable (plan WS-7); not one of the three
# binaries `install` puts on the host PATH.
build-harp:
    just -f justfile.container harp::build

# Build + compress all four binaries (UPX). Codegen prerequisites run here for
# ctxloom, then each module's build-compressed builds and UPX-compresses its
# binary. Used by the host `install`/`build-compressed`.
build-compressed: validate proto gen-schemas
    just -f justfile.container ctxloom::build-compressed
    just -f justfile.container ltk::build-compressed
    just -f justfile.container taskloom::build-compressed
    just -f justfile.container harp::build-compressed

# Build all four binaries UNCOMPRESSED (ctxloom + ltk + taskloom + harp).
# Codegen prereqs run here for ctxloom. Used by the host `install`: UPX LZMA
# decompression adds ~1.5s/exec, so local installs stay uncompressed; UPX is
# reserved for release artifacts (see .goreleaser.yml).
build-all-bins: validate proto gen-schemas
    just -f justfile.container ctxloom::build
    just -f justfile.container ltk::build
    just -f justfile.container taskloom::build
    just -f justfile.container harp::build

# ===== Release validation (goreleaser, in-container only) =====

# Validate .goreleaser.yml without building anything.
release-check:
    goreleaser check

# Snapshot-build the release BINARIES for THIS platform only, into dist/.
#
# `build --single-target`, not `release`: the full matrix needs the
# goreleaser-cross toolchains (o64-clang, llvm-mingw) that CI has and this
# image does not, so a full local run would fail on the darwin/windows-arm64
# legs. Archives/checksums are therefore NOT exercised here — `release-check`
# plus CI cover those. What this DOES prove is the build IDs and real UPX
# compression of the `-upx` twins (upx is installed here; it is NOT on the
# host, which is exactly why goreleaser must never run there).
release-snapshot: validate proto gen-schemas
    goreleaser build --snapshot --clean --single-target

# ===== Cross-compilation targets =====

# Build for Linux amd64
build-linux-amd64:
    GOOS=linux GOARCH=amd64 CGO_ENABLED=0 \
        go build {{buildvcs}} {{trimpath}} \
        -ldflags "-s -w -X github.com/ctxloom/ctxloom/internal/version.Version={{version}}" \
        -o ctxloom-linux-amd64 ./cmd/ctxloom

# Build for Linux arm64
build-linux-arm64:
    GOOS=linux GOARCH=arm64 CGO_ENABLED=0 \
        go build {{buildvcs}} {{trimpath}} \
        -ldflags "-s -w -X github.com/ctxloom/ctxloom/internal/version.Version={{version}}" \
        -o ctxloom-linux-arm64 ./cmd/ctxloom

# Build for Windows amd64
build-windows-amd64:
    GOOS=windows GOARCH=amd64 CGO_ENABLED=0 \
        go build {{buildvcs}} {{trimpath}} \
        -ldflags "-s -w -X github.com/ctxloom/ctxloom/internal/version.Version={{version}}" \
        -o ctxloom-windows-amd64.exe ./cmd/ctxloom

# Build for macOS amd64
build-darwin-amd64:
    GOOS=darwin GOARCH=amd64 CGO_ENABLED=0 \
        go build {{buildvcs}} {{trimpath}} \
        -ldflags "-s -w -X github.com/ctxloom/ctxloom/internal/version.Version={{version}}" \
        -o ctxloom-darwin-amd64 ./cmd/ctxloom

# Build for macOS arm64
build-darwin-arm64:
    GOOS=darwin GOARCH=arm64 CGO_ENABLED=0 \
        go build {{buildvcs}} {{trimpath}} \
        -ldflags "-s -w -X github.com/ctxloom/ctxloom/internal/version.Version={{version}}" \
        -o ctxloom-darwin-arm64 ./cmd/ctxloom

# Build all platforms
build-all: build-linux-amd64 build-linux-arm64 build-windows-amd64 build-darwin-amd64 build-darwin-arm64

# ===== UPX Compression =====

# Compress Linux amd64 binary with UPX
compress-linux-amd64:
    upx --best --lzma ctxloom-linux-amd64

# Compress Linux arm64 binary with UPX
compress-linux-arm64:
    upx --best --lzma ctxloom-linux-arm64

# Compress Windows binary with UPX
compress-windows-amd64:
    upx --best --lzma ctxloom-windows-amd64.exe

# Note: UPX doesn't support macOS binaries well (code signing issues)
# macOS binaries are not compressed

# Compress all compressible binaries
compress-all: compress-linux-amd64 compress-linux-arm64 compress-windows-amd64

# Compress the main ctxloom binary (for local dev) — delegated to the ctxloom
# module. For all three binaries use `build-compressed`.
compress:
    just -f justfile.container ctxloom::compress

# Build and compress all platforms
release: build-all compress-all

# ===== Testing =====

# THE developer/agent entry point inside the container: runs BOTH test groups
# and fails if EITHER fails. Mirrors the host justfile's `test` — see that
# recipe's comment for why the exit codes are captured per group instead of
# relying on a dependency list.
#
# CI does NOT call this: .github/workflows/ci.yml invokes `test-default` and
# `test-arch` as two separate steps so a red step names the class of thing that
# broke. Nothing runs twice.
test:
    #!/usr/bin/env bash
    # No `set -e`: each group's exit code is captured and checked explicitly, so
    # a failing first group cannot abort before the second runs and cannot be
    # masked by the second succeeding.
    set -uo pipefail
    failed=()
    echo "===== [1/2] default suite (untagged) — just test-default"
    if ! just -f justfile.container test-default; then failed+=("test-default"); fi
    echo ""
    echo "===== [2/2] architectural invariants (-tags arch) — just test-arch"
    if ! just -f justfile.container test-arch; then failed+=("test-arch"); fi
    echo ""
    if [ "${#failed[@]}" -ne 0 ]; then
        echo "FAILED GROUP(S): ${failed[*]}" >&2
        echo "  test-default = the ordinary untagged suite (go test ./..., plain + -race)" >&2
        echo "  test-arch    = the architectural class gates (-tags arch, -run TestArch_)" >&2
        echo "Re-run just that group to iterate on it." >&2
        exit 1
    fi
    echo "both groups passed: test-default + test-arch"

# The untagged suite — everything that is NOT an architectural class gate.
# Coverage is filtered through .coverignore so the number CI uploads
# to Codecov excludes generated files (protobuf, gRPC) — matching the host
# justfile `test-default` recipe instead of reporting a raw,
# generated-file-diluted figure.
#
# Carries no `-tags arch`, so the 38 TestArch_ gates do NOT run here; `test-arch`
# is their execution path and `test` runs both.
test-default:
    #!/usr/bin/env bash
    set -e
    # Mirrors the host justfile's `test`: gate on BOTH the plain (no-race) and
    # -race suites, not just -race — see the host recipe's comment for why
    # (the no-race path is what gremlins/`just cover` actually run, and it was
    # gating nothing). `set -e` aborts here on either failure.
    go test ./...
    # Unique per-invocation raw profile — see the host justfile's `test`
    # recipe for why a fixed coverage.raw.out name races concurrent runs.
    raw="$(mktemp coverage.raw.XXXXXX.out)"
    trap 'rm -f "$raw"' EXIT
    go test -race -coverprofile="$raw" ./...
    just -f justfile.container _check-no-ctxloom-leak
    just -f justfile.container _filter_coverage "$raw" coverage.out

# Fail (and clean up) if any test wrote a nested internal/**/.ctxloom into the
# source tree instead of isolating through t.TempDir() — see the host
# justfile's _check-no-ctxloom-leak for the full explanation.
_check-no-ctxloom-leak:
    #!/usr/bin/env bash
    set -e
    leaked="$(find internal -mindepth 2 -type d -name .ctxloom 2>/dev/null)"
    if [ -n "$leaked" ]; then
        echo "$leaked" | xargs -I{} rm -rf {}
        echo "TEST ISOLATION FAILURE: a test wrote a nested .ctxloom into the source tree (should use t.TempDir()):" >&2
        echo "$leaked" >&2
        exit 1
    fi

# Filter coverage output using patterns from .coverignore (mirrors the host
# justfile so local and CI coverage are computed identically).
# Usage: _filter_coverage <input> <output>
_filter_coverage INPUT OUTPUT:
    #!/usr/bin/env bash
    set -e
    if [ -f .coverignore ]; then
        # Build grep pattern from .coverignore (skip comments and empty lines)
        patterns=$(grep -v '^#' .coverignore | grep -v '^$' | paste -sd '|' -)
        if [ -n "$patterns" ]; then
            grep -Ev "$patterns" "{{INPUT}}" > "{{OUTPUT}}" || cp "{{INPUT}}" "{{OUTPUT}}"
            exit 0
        fi
    fi
    cp "{{INPUT}}" "{{OUTPUT}}"

# Run tests with the treesitter (CGO) build tag — exercises the code compressor
test-treesitter:
    CGO_ENABLED=1 go test -race -tags treesitter ./internal/compression/...

# Run a single package's tests under -race (fast iteration inside the
# container). Mirrors the host justfile's test-pkg: a `-run` pattern that
# matches nothing still exits 0 from `go test` (`ok ... [no tests to run]`),
# silently passing a typo'd/renamed test name — detect that and fail. A
# package with genuinely no test files reports a different message
# (`? ... [no test files]`) and stays green.
test-pkg PKG *ARGS:
    #!/usr/bin/env bash
    set -euo pipefail
    pkg="$1"; shift
    set +e
    output=$(go test -race "$@" "$pkg" 2>&1)
    status=$?
    set -e
    printf '%s\n' "$output"
    if [ "$status" -ne 0 ]; then
        exit "$status"
    fi
    if grep -q '\[no tests to run\]' <<<"$output"; then
        echo "error: -run matched no tests in $pkg (typo'd or renamed test name?)" >&2
        exit 1
    fi

# Run integration tests (requires ctxloom binary)
test-integration: build
    go test -v -tags integration ./tests/integration/...

# Run the full-stack acceptance suite (godog) inside the container. Hermetic by
# default; @live scenarios are opt-in and self-skip without credentials.
# -v: this is what CI actually invokes (ci.yml: `just -f justfile.container
# test-acceptance`) — without it, a passing `go test` run buffers ALL of the
# test binary's stdout (the live-engine availability report printed once up
# front, and godog's own "pretty" per-scenario output) and only shows it on
# failure, which had silently made every green CI run of this suite mute.
test-acceptance: build
    go test -v -tags "acceptance integration" -count=1 ./tests/acceptance/...

# Generate the "living docs" journey pages inside the container: same as the
# host justfile's gen-living-docs, but via this file's own `build` (no
# docker-in-docker) — this is how the docs deploy workflow
# (.github/workflows/docs.yml) runs it, mirroring how the acceptance job
# invokes `just -f justfile.container test-acceptance`.
gen-living-docs: build
    #!/usr/bin/env bash
    set -euo pipefail
    # Absolute path: see the host justfile's gen-living-docs for why a
    # relative CTXLOOM_DOC_CAPTURE_DIR silently breaks (go test's cwd is the
    # package dir, not the repo root).
    capture_dir="$(pwd)/.cache/doc-capture"
    rm -rf "$capture_dir"
    CTXLOOM_DOC_CAPTURE_DIR="$capture_dir" go test -tags "acceptance integration" -count=1 ./tests/acceptance/...
    go run ./scripts/gendocs/livingdocs --capture-dir "$capture_dir"

# test-docker-integration comes from build/gates.justfile (imported at the top
# of this file AND by the host justfile) — this is the recipe
# .github/workflows/ci.yml invokes. It used to be a SECOND, shorter copy of
# the host recipe under the same name, running only ./internal/lm/isolation/...,
# so the entire internal/agentcoord/coord docker suite had never executed in
# CI. Running it here requires the devcontainer to see the host's runtime
# (docker CLI + a shared/mounted daemon socket); CI sets
# CTXLOOM_REQUIRE_DOCKER=1 so a runner that CANNOT see it fails loudly instead
# of skipping to green.

# ===== Validation =====

# Validate fragment YAML files
validate:
    go run ./cmd/validate

# Generate protobuf code
proto:
    buf generate

# Compile-check the `-tags integration` build fence — a cheap rot gate for
# tag-gated tests (tests/integration/*_test.go). Nothing else on the default
# path ever type-checks this tag: golangci-lint's build-tags list carries only
# `mutation` (see .golangci.yml for why this one is not on it),
# and `test`/coverage exclude build-tagged files by construction (they simply
# don't match `./...` without the tag). A test file that only compiles under
# the tag can therefore bit-rot silently — exactly what happened to
# acp_agent_test.go (stale agent.ChatRequest.AutoApprove field, replaced by
# the Permissions/PermissionMode enum) and acp_live_test.go
# (claude.NewClaudeCode's old one-arg signature), both invisible until
# something finally ran `go vet -tags integration`. vet, not test/run — stays
# cheap enough to gate every lint pass.
# The SECOND vet line covers the `acceptance` tag, which gates ~23k lines the
# integration tag does not reach. Both matrices are vetted because a package
# that compiles under one tag set and not the other is invisible to `go build
# ./...` either way, and golangci-lint does not build tag-gated files at all.
vet-integration:
    go vet -tags integration ./tests/...
    go vet -tags "acceptance integration" ./tests/...

# Lint code, plus the integration-tag rot gate (see vet-integration).
lint: vet-integration
    golangci-lint run

# Regenerate the published JSON Schemas for ctxloom's JSON output into the
# gitignored resources/schema/gen/ by reflecting their producing Go structs.
# A generated build artifact (like protobuf): a `build` dependency and a CI
# step, not checked in. Build-tagged `schemagen` so the reflection dependency
# never enters the production binary.
gen-schemas:
    go run -tags schemagen ./cmd/gen-schemas

# Generate the reference docs for all three binaries from their sources of
# truth: the CLI reference (man pages + website markdown) from each cobra
# command tree, the MCP reference from the live tool/resource registrations, and
# ctxloom's and taskloom's config references from their tracked JSON Schemas. One generator
# (internal/docsgen) serves all three; taskloom and ltk keep their trees in
# `package main`, so it mounts on them as a hidden `gendocs` subcommand compiled
# only under `-tags docsgen`. The website pages are checked in, the man pages are
# gitignored release artifacts.
gen-docs:
    go run ./scripts/gendocs \
        --man man/man1 \
        --markdown website/src/content/docs/reference/cli \
        --mcp website/src/content/docs/reference \
        --config website/src/content/docs/reference \
        --config-schema resources/schema/input/config-schema.json
    go run -tags docsgen ./cmd/taskloom gendocs \
        --man man/man1 \
        --markdown website/src/content/docs/taskloom/reference/cli \
        --mcp website/src/content/docs/taskloom/reference \
        --config website/src/content/docs/taskloom/reference \
        --config-schema resources/schema/input/taskloom-config-schema.json
    go run -tags docsgen ./cmd/ltk gendocs \
        --man man/man1 \
        --markdown website/src/content/docs/ltk/reference/cli

# Drift gate: regenerate every product's reference docs and fail if the
# checked-in website pages (ctxloom CLI/MCP/config, taskloom CLI/MCP, ltk CLI) no
# longer match their sources of truth. man/man1 is gitignored, so only the
# website tree is gated. Run in the CI lint job.
#
# Two checks, because they catch different failures: `git diff` catches a CHANGED
# page (an edited Short/Long, a renamed flag), and the untracked-file check
# catches an ADDED one — a brand-new command whose page was never committed would
# otherwise leave the diff clean and sail through.
gen-docs-check: gen-docs
    #!/usr/bin/env bash
    set -euo pipefail
    git diff --exit-code -- website/src/content/docs
    untracked=$(git ls-files --others --exclude-standard -- website/src/content/docs)
    if [ -n "$untracked" ]; then
        echo "Generated reference pages are not checked in (run \`just gen-docs\` and commit):" >&2
        echo "$untracked" >&2
        exit 1
    fi

# Regenerate the proto-canonical MCP tool schemas AND the <ctxloom-reminder>
# frame encoders from the buf-built descriptor set (source info included by
# default). Both outputs are checked in and both are goldens.
#
# The encoder half FAILS THE BUILD on an invalid frame declaration — an
# un-annotated field, or free text smuggled into an attribute (see
# internal/agentcoord/mcpschema/xmllike.go). That is deliberate: it is the whole
# reason the frames are generated rather than rendered reflectively.
gen-mcp-schemas:
    #!/usr/bin/env bash
    set -euo pipefail
    tmp=$(mktemp)
    trap 'rm -f "$tmp"' EXIT
    buf build -o "$tmp"
    go run ./internal/agentcoord/mcpschema/gen -descriptor "$tmp" \
        -out internal/agentcoord/mcpschema/schemas \
        -xmllike-out internal/agentcoord/xmllike_gen.go

# Drift gate: the checked-in schemas and frame encoders ARE the goldens —
# regenerate and fail on any difference (the gen-docs-check pattern). Run in the
# CI lint job.
gen-mcp-schemas-check: gen-mcp-schemas
    git diff --exit-code -- internal/agentcoord/mcpschema/schemas internal/agentcoord/xmllike_gen.go

# Per-function cyclomatic complexity (lizard) — human-readable table + warnings.
# Defaults to repo root; pass paths/flags to scope. Leading `-` ignores lizard's
# non-zero exit when functions exceed the threshold, so this stays a report.
complexity *ARGS:
    -lizard -x "*.pb.go" -x "*/website/*" {{ if ARGS == "" { "." } else { ARGS } }}

# Per-function complexity as CSV (header prepended) for LLM/tooling ingest.
# Columns: nloc,ccn,tokens,params,length,location,file,function,long_name,start,end
complexity-csv *ARGS:
    #!/usr/bin/env bash
    set -uo pipefail
    echo "nloc,ccn,tokens,params,length,location,file,function,long_name,start,end"
    lizard -x "*.pb.go" -x "*/website/*" --csv {{ if ARGS == "" { "." } else { ARGS } }} || true

# Enforcing gate: fail if any function is a NEW (or newly-worsened) CCN>10
# violation not already accounted for in .complexity-baseline.txt. Pre-existing
# violations (282 as of the baseline's creation — DEBT, not an approved state,
# see that file's header) do not fail this gate; a violation absent from the
# baseline, or a baselined one whose CCN increased, does. Run in the lint job
# alongside golangci-lint. See scripts/complexity_gate.py for the full design
# rationale (identity scheme, known blind spots).
complexity-check:
    python3 scripts/complexity_gate.py check

# Deliberately regenerate .complexity-baseline.txt from the CURRENT tree's
# violations. This is the ONLY sanctioned way that file changes — never hand
# edit it, never a side effect of `complexity-check`. Review the diff before
# committing: a shrinking baseline is progress; a growing one is you knowingly
# accepting new/worsened complexity debt, and that belongs in the commit
# message.
complexity-baseline-update:
    python3 scripts/complexity_gate.py generate > .complexity-baseline.txt

# Format code
fmt:
    go fmt ./...

# Tidy dependencies
tidy:
    go mod tidy
