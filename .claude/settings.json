{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "ctxloom hook stamp-plan"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "ltk evaluate --config .ltk/config.yaml"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ctxloom hook session-bind"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ctxloom hook hud"
  }
}