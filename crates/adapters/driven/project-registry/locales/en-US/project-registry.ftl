project-registry-no-home = no home directory: set HOME
project-registry-io = { $path }: { $detail }
project-registry-invalid-id = the project id { $id } from { $origin } is not a valid id: { $reason }
project-registry-unreadable = the project registry { $path } cannot be read: { $detail }
project-registry-exhausted = no free project id after { $attempts } tries
project-registry-no-cwd = the working directory cannot be read: { $detail }
project-registry-relative-path = { $path } is not an absolute path: nothing is written relative to the working directory
project-registry-lock-timeout = the project registry's lock { $path } is still held after { $waited_ms }ms: another ctxloom or taskloom process holds it; try again once it exits
project-registry-lock-replaced = the project registry's lock { $path } was replaced { $attempts } times while being taken: try again
project-registry-changed = the project registry or a marker changed while the change was planned: nothing was changed; run it again
project-registry-not-a-database = { $path } is not a project's database directory: not removed
project-registry-stale-worktree = { $root } is a linked worktree whose git directory { $git_dir } is gone: run `git worktree repair` from its primary checkout, or remove the worktree
