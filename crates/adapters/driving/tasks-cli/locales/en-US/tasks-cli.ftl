tasks-cli-output = cannot write the output: { $detail }
tasks-cli-import-incomplete = not everything was imported: { $stopped } projects stopped, { $lost } records not imported
tasks-cli-usage = { $detail }
tasks-cli-project = project { $root } ({ $id })
tasks-cli-no-project = no project here yet: nothing to list
tasks-cli-loadout-format = the loadout is printed only as yaml, not { $format }
tasks-cli-every-project = no project here: { $directory } is in no git repository, has no CTXLOOM_ROOT and no project of its own, so this reads every project; pass --project <id>, or work in a project, to read one
tasks-cli-hidden = { $hidden } more matching tasks hidden by the default view ({ $completed } completed, { $deferred } deferred): add --all to include them
tasks-cli-omitted = { $omitted } more tasks omitted by --limit: raise or drop it to see them (summary's counts are unaffected)
tasks-cli-lint-violations = { $count } tag-standard violations found
tasks-cli-lint-checked-nothing = lint checked no target: the tag schema declares no enum or range, so a clean sweep proves nothing
tasks-cli-nothing-to-prune = no project here yet: nothing to prune
tasks-cli-report-only = removed nothing: this was a report, not a removal; to apply exactly this plan, run it again with --yes: { $command }
