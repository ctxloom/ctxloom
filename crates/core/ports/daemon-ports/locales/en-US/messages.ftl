daemon-ports-refused = the daemon refused the call: { $code }
daemon-ports-unauthenticated = the daemon did not take this client's credential
daemon-ports-unauthenticated-fix = the daemon may have restarted: run the command again
daemon-ports-unimplemented = the daemon does not serve { $method }
daemon-ports-unimplemented-fix = the daemon may be another version of ctxloom: ctxloom daemon stop, then run the command again
daemon-ports-unreachable = the daemon could not be reached: { $ext_err_txt }
daemon-ports-failed = the daemon's call failed ({ $code }): { $ext_err_txt }
daemon-ports-not-started = no ctxloom daemon could be started; its log is { $log }
