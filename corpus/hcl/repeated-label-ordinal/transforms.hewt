hew-transforms: 1
target: target.tf
format: hcl
transforms:
  - op: test
    path: /provider/"aws"[0]/region
    value: us-west-1
  - op: test
    path: /provider/"aws"[0]/profile
    value: default
  - op: replace
    path: /provider/"aws"[0]/region
    value: us-west-2
  - op: test
    path: /provider/"aws"[1]/alias
    value: east
  - op: test
    path: /provider/"aws"[1]/region
    value: us-east-1
  - op: add
    path: /provider/"aws"[1]/profile
    after: /provider/"aws"[1]/region
    value: ctxloom
