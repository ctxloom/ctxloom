{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ctxloom session bind",
            "name": "ctxloom-managed"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "ctxloom": {
      "command": "ctxloom",
      "args": [
        "mcp"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@anthropics/mcp-server-sequential-thinking"
      ]
    }
  }
}