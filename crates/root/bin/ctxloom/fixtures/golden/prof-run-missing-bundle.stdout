{
  "resolved": {
    "workspace": "none",
    "runtime": "host"
  },
  "environment": {
    "runtime": "host",
    "reach": "loopback"
  },
  "llm": "claude-code",
  "backend": "claude-code",
  "profiles": [
    "missing-bundle"
  ],
  "fragments": [
    "ctxloom+local:a#fragments/a1",
    "ctxloom+local:a#fragments/a2"
  ],
  "context": "FRAG-a1 {{who}} {{greeting}}\n\n---\n\nFRAG-a2",
  "delivery": [
    {
      "kind": "context",
      "approach": "system-prompt",
      "root": "session-home",
      "unsafe": false
    },
    {
      "kind": "mcp",
      "approach": "mcp-config",
      "root": "session-home",
      "unsafe": false
    },
    {
      "kind": "settings",
      "approach": "settings",
      "root": "session-home",
      "unsafe": false
    },
    {
      "kind": "hooks",
      "approach": "settings-hooks",
      "root": "session-home",
      "unsafe": false
    },
    {
      "kind": "commands",
      "approach": "commands-dir",
      "root": "session-home",
      "unsafe": false
    }
  ],
  "engine_home": {
    "mode": "session",
    "unsafe": false
  },
  "tokens": 11,
  "findings": [
    {
      "kind": "bundle",
      "text": "failed to load bundle \"does-not-exist\"; the MCP servers and hooks it ships are not applied: bundle not found: does-not-exist",
      "remedy": "run `ctxloom deps pull` or fix the bundle ref, or pass --degraded",
      "fatal": true
    }
  ]
}