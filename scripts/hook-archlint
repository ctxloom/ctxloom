#!/usr/bin/env bash
# lefthook's archlint pre-commit gate; lefthook.yml carries why it is shaped
# this way. Run with bash explicitly: lefthook hands a run block to /bin/sh,
# which is not bash everywhere a commit is made.
set -euo pipefail

# archlint type-checks the whole module, and generated code (protobuf) is not
# committed: without it every package importing the generated types fails to
# type-check, so a fresh worktree's first commit could never pass. The recipe
# writes only files whose content differs, so an up-to-date tree pays only for
# the generator run.
just _require-generated

# A missing or stale linter is REBUILT, never skipped: a gate that reports
# success having run nothing is the failure the rules themselves exist to
# catch, and a stale binary enforces the rules it was built with, not the ones
# on disk. The staleness test is a file comparison, so the common path costs
# nothing.
if [ ! -x bin/archlint ] || [ -n "$(find internal/shared/archrules internal/shared/archlint cmd/archlint -name '*.go' -newer bin/archlint -print -quit)" ]; then
  just build-archlint
fi
scripts/lint-arch-passes.sh
