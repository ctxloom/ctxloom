// ctxloom's dev container: agents and every just gate run inside it, the
// first real boundary between an agent and the host. The image is the
// Containerfile beside this file (see its header).
//
// Open the PRIMARY checkout (its .git is a directory). A linked worktree's
// .git names the primary's .git/worktrees/<name>, which is not mounted unless
// the commented `mounts` entry below says where it is.
//
// Docker (rootful) is assumed: the `node` user (uid 1000) is remapped to the
// host's uid (updateRemoteUserUID), so files on the bind mount keep the
// host user's ownership. Under rootless podman use the commented runArgs
// instead (keep-id maps the host uid onto the same uid in the container).
// Rootless docker cannot map the host uid onto a non-root user: there the
// host user is the container's root.
{
  "name": "ctxloom",
  "build": {
    "dockerfile": "Containerfile",
    "context": ".",
    // The checkout's parent, writable, for the gates' throwaway worktrees
    // (the Containerfile's last step).
    "args": { "WORKSPACE_PARENT": "${localWorkspaceFolder}/.." }
  },

  // The repository at its own path, so paths in logs, the git worktrees the
  // gates make beside the checkout and absolute paths in the store mean the
  // same thing inside and out.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",

  // cargo's caches and the build output on named volumes, never the host's
  // /home: the registry and git caches shared by every ctxloom container, the
  // target dir this container's own. The gates' staged tree and the ratchet
  // base build under it too (target/staged and target/ratchet-base follow an
  // outer CARGO_TARGET_DIR); only the gates' logs stay in the checkout's
  // target/logs.
  "mounts": [
    "source=ctxloom-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    "source=ctxloom-cargo-git,target=/usr/local/cargo/git,type=volume",
    "source=ctxloom-target-${devcontainerId},target=/cargo-target,type=volume",
    // Every worktree of the repository, at its own path (the layout's
    // ~/workspace/worktrees, which must exist on the host). A git command run
    // here sees each worktree's directory, so nothing judges one gone because
    // only the checkout was mounted (2026-11-12: a prune in the container
    // deleted the records of every worktree outside it).
    "source=${localEnv:HOME}/workspace/worktrees,target=${localEnv:HOME}/workspace/worktrees,type=bind"
    // A linked worktree opened as the workspace: the primary checkout's .git,
    // at its own path.
    // ,"source=/path/to/primary/.git,target=/path/to/primary/.git,type=bind"
    //
    // ctxloom's home (`just install`'s CTXLOOM_HOME, ~/.ctxloom-rs: the
    // project stores) kept across rebuilds, apart from the host's:
    // ,"source=ctxloom-home-${devcontainerId},target=/home/node/.ctxloom-rs,type=volume"
    //
    // Engine logins: see "Engine credentials" below.
  ],

  "remoteUser": "node",
  "containerUser": "node",
  "updateRemoteUserUID": true,
  // Rootless podman instead of docker:
  // "runArgs": ["--userns=keep-id"],
  // "updateRemoteUserUID": false,

  "containerEnv": {
    "CARGO_TARGET_DIR": "/cargo-target"
  },

  "remoteEnv": {
    // `just install` puts ctxloom in ~/.local/bin.
    "PATH": "/home/node/.local/bin:${containerEnv:PATH}",
    // gh, from the host's environment; no gh config is mounted. Unset on the
    // host, it is empty here and gh is signed out.
    "GH_TOKEN": "${localEnv:GH_TOKEN}",

    // Engine credentials (owner, 2026-11-12): TOKENS from the host's
    // environment only. No login file is mounted or copied in: several agents
    // refreshing one OAuth login sign each other out, and a child run needs a
    // variable anyway. Unset on the host, each is empty here. `claude
    // setup-token` gives a CLAUDE_CODE_OAUTH_TOKEN.
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}"
  },

  // The host's git identity, name and email only (no signing key, credential
  // helper or alias): read on the host, applied in the container.
  "initializeCommand": "sh .devcontainer/host-identity.sh",
  "postCreateCommand": "sh .devcontainer/post-create.sh"
}
