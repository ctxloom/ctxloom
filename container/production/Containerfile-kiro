# Production ctxloom agent image (kiro) — the AGENT-SPECIFICS stage: a real
# kiro-cli plus the locally-built ctxloom binary, layered onto the shared base
# image (container/base/Containerfile by default; a user base via
# isolation_base_containerfile / `container build --base-containerfile`). The
# plugin (`ctxloom llm serve kiro`) spawns `kiro-cli` INSIDE the container for an
# isolated run. Mirrors Containerfile-claude-code and is the target of the kiro
# container profile's image tag (ctxloom-agent-kiro:latest).
#
# BASE CONTRACT: Debian-family with apt. The installer prerequisites (curl,
# certs, unzip) are installed here anyway — a no-op on the default base, which
# already carries them — so a lean user base still builds.
#
# AUTH is NOT baked in — it crosses at RUN time via KIRO_API_KEY env passthrough
# (Kiro's headless mode skips the browser login when it is set). Subscription
# `kiro-cli login` credential mounts are a follow-up pending live verification of
# the credential file layout (the same doc-first posture as the kiro settings
# writer). The image ships no secrets and is safe to cache/share.
#
# No ENTRYPOINT: the isolation runtime builds the full in-container argv
# (/usr/local/bin/ctxloom llm serve kiro ...) on a writable base with a fresh
# HOME. The build context must contain the static binary at ./ctxloom.
ARG BASE_IMAGE=ctxloom-agent-base:latest
FROM ${BASE_IMAGE}
ENTRYPOINT []

# Install kiro-cli via the official installer and fail the build if it is not
# runnable, so a broken image never ships. The binary lands under ~/.local/bin
# and is relocated to /usr/local/bin where any uid finds it (the rootful-docker
# path runs the container --user <host uid>, not root).
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates unzip \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://cli.kiro.dev/install | bash \
    && { command -v kiro-cli >/dev/null 2>&1 \
         || install -m 0755 /root/.local/bin/kiro-cli /usr/local/bin/kiro-cli; } \
    && kiro-cli --version

COPY ctxloom /usr/local/bin/ctxloom
# Validate the layered ctxloom runs on this base (the daily build is
# glibc-linked; an ABI mismatch must fail the build, not the run).
RUN /usr/local/bin/ctxloom version
