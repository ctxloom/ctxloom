{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          { "args": ["hook", "tool-reflect", "--min-output-bytes", "2048"], "command": "ctxloom", "timeout": 5, "type": "command" }
        ]
      },
      {
        "hooks": [
          { "args": ["hook", "stamp-plan"], "command": "ctxloom", "type": "command" }
        ],
        "matcher": "Edit|Write"
      },
      { "hooks": [{ "args": ["hook", "skill-mates"], "command": "ctxloom", "timeout": 15, "type": "command" }], "matcher": "Skill" }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "ltk evaluate",
            "type": "command"
          }
        ],
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "args": ["hook", "session-bind"], "command": "ctxloom", "type": "command" },
          { "args": ["hook", "session-start"], "command": "ctxloom", "timeout": 15, "type": "command" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "args": ["hook", "next-step"], "command": "ctxloom", "timeout": 15, "type": "command" }
        ]
      }
    ],
    "UserPromptSubmit": [{ "hooks": [{ "args": ["hook", "mail-drain"], "command": "ctxloom", "timeout": 5, "type": "command" }] }]
  },
  "statusLine": {
    "command": "ctxloom hook hud",
    "type": "command"
  },
  "worktree": {
    "baseRef": "head"
  },
  "env": { "BASH_DEFAULT_TIMEOUT_MS": "600000", "BASH_MAX_TIMEOUT_MS": "3600000" }
}
