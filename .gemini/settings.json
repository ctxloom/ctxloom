{
  "hooks": {
    "AfterTool": [
      {
        "hooks": [
          {
            "command": "ctxloom hook stamp-plan",
            "name": "ctxloom-managed",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "command": "ltk evaluate",
            "name": "ctxloom-managed",
            "type": "command"
          }
        ],
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "ctxloom hook session-bind",
            "name": "ctxloom-managed",
            "type": "command"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "ctxloom": {
      "args": [
        "mcp"
      ],
      "command": "ctxloom"
    },
    "sequential-thinking": {
      "args": [
        "-y",
        "@anthropics/mcp-server-sequential-thinking"
      ],
      "command": "npx"
    },
    "taskloom": {
      "args": [
        "mcp"
      ],
      "command": "taskloom"
    }
  }
}
