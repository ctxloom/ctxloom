      "_ctxloom": "bundle:ctxloom+local:code-quality",
      "args": [
        "--readonly"
      ],
      "command": "mcp-postgres",
      "env": {
        "PGDATABASE": "app",
        "PGHOST": "localhost",
        "PGPORT": "5432"
      },
      "installation": "brew install mcp-postgres",
      "notes": "Read-only connection to the app database."
    }
  },
  "Commands": [
    {
      "AllowedTools": null,
      "ArgumentHint": "",
      "Content": "blob:03f2404642a89e478b138fe20013c4e3452f476da8d569129c14ebdf62734abf",
      "Description": "",
      "Enabled": true,
      "Model": "",
