module github.com/ctxloom/ctxloom

go 1.25.0

// ctxloom-local fork of hashicorp/go-plugin@v1.7.0 with a single env-gated
// serverListener patch (PLUGIN_LISTEN_TCP=1 forces the TCP listener) so the
// containerized backend plugin can speak TCP over host loopback across the
// Docker Desktop VM boundary on macOS/Windows. Self-contained relative replace:
// resolves identically under the host go.work AND container/CI GOWORK=off builds
// (the devcontainer mounts the repo root, so ./third_party is present). See
// third_party/go-plugin/CTXLOOM_FORK.md. Migrate to an org fork before release.
replace github.com/hashicorp/go-plugin => ./third_party/go-plugin

// TEMPORARY: ctxloom's ACP wire types (internal/acp/api, deleted in this
// change) are now schema-generated by benjaminabbitt/acp-go-sdk, a fork of
// coder/acp-go-sdk (branch schema-v1.19.0) that adds a generator + targets
// ACP schema-v1.19.0 — byte-identical to ctxloom's own vendored schema at
// internal/acptest/acp-schema-v1.json. The fork's PR upstream to
// coder/acp-go-sdk has NOT yet merged, so this replace redirects the
// upstream-named requirement to the fork until it does.
// REMOVAL CONDITION: once github.com/coder/acp-go-sdk publishes a release
// carrying schema-v1.19.0 (i.e. the fork's PR merges and ships), delete this
// replace line and bump the github.com/coder/acp-go-sdk require version to
// that release — no source changes needed, ctxloom imports the upstream
// path already.
replace github.com/coder/acp-go-sdk => github.com/benjaminabbitt/acp-go-sdk v0.13.6-0.20260716172546-89c5c8173ab4

// clifmt (Phase 0 of the CLI-primary reorg) is a separate, independently
// versioned module shared across ctxloom/harp/taskloom/ltk. No tagged
// release exists yet, so it resolves via a relative replace to the sibling
// checkout at ../../clifmt (both are worktrees under workspace/ctxloom/).
// Swap this for a real version requirement once clifmt cuts its first tag.
replace github.com/ctxloom/clifmt => ../../clifmt

require (
	github.com/Masterminds/semver/v3 v3.5.0
	github.com/bmatcuk/doublestar/v4 v4.10.0
	github.com/cbroglie/mustache v1.4.0
