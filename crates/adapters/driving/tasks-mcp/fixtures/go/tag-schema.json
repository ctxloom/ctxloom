{
  "targets": [
    {
      "target": "triage:audited",
      "scalar": true,
      "range": {
        "min": 20250101,
        "max": 20991231
      }
    },
    {
      "target": "triage:blocks-release",
      "scalar": true
    },
    {
      "target": "triage:effort",
      "scalar": true,
      "range": {
        "min": 0,
        "max": 5
      }
    },
    {
      "target": "triage:exposed",
      "enum": [
        "wire",
        "cli",
        "config",
        "on-disk",
        "api"
      ]
    },
    {
      "target": "triage:kind",
      "scalar": true,
      "enum": [
        "defect",
        "capability",
        "chore"
      ],
      "priority_fn": "({{triage:level}} \u003e 0 ? 2 ** (3 - {{triage:level}}) : 0.1) * {{age_factor}} * (1 + {{triage:blocks-release=*}}) / (1 + {{triage:effort}}/2)",
      "decay_fn": "{{triage:exposed=*}} \u003e 0 ? 1 + {{age_days}}/({{age_days}}+90) : {{triage:blind-gate=*}} \u003e 0 ? 1 + {{age_days}}/({{age_days}}+30) : {{triage:kind=capability}} \u003e 0 ? 0.4 + 0.6 * 0.5 ** ({{age_days}}/120) : {{triage:kind=chore}} \u003e 0 ? 0.5 + 0.5 * 0.5 ** ({{age_days}}/180) : 1"
    },
    {
      "target": "triage:level",
      "scalar": true,
      "range": {
        "min": 1,
        "max": 5
      }
    },
    {
      "target": "triage:verdict",
      "scalar": true,
      "enum": [
        "holds",
        "phantom",
        "obsolete",
        "partial",
        "unclear"
      ]
    }
  ]
}