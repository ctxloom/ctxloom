== engine=claude-code profile=golden-auto managed
{
  "BundleMCP": {
    "ctxloom": {
      "_ctxloom": "bundle:ctxloom+companion:ctxloom",
      "notes": "blob:4463890a217062b9bd6378428aa8f5df959d3281e0ee62ceb2248674b8b81c08",
      "served_by": "session-endpoint"
    },
    "postgres": {
      "_ctxloom": "bundle:ctxloom+local:code-quality",
      "args": [
        "--readonly"
      ],
      "command": "mcp-postgres",
      "env": {
        "PGDATABASE": "app",
        "PGHOST": "localhost",
        "PGPORT": "5432"
      },
      "installation": "brew install mcp-postgres",
      "notes": "Read-only connection to the app database."
    }
  },
  "Commands": [
    {
      "AllowedTools": null,
      "ArgumentHint": "",
      "Content": "blob:03f2404642a89e478b138fe20013c4e3452f476da8d569129c14ebdf62734abf",
      "Description": "Review Deferred tasks and surface any whose revive trigger has fired",
      "Enabled": true,
      "Model": "",
      "Name": "check-triggers"
    },
    {
      "AllowedTools": null,
      "ArgumentHint": "",
      "Content": "blob:8c31ad9321fdae7d965185978ec41cf97d56dbd20eab7f21616a44aba8a9be1f",
      "Description": "Configure or reconfigure ctxloom for this project — companions, profiles, and agents",
      "Enabled": true,
      "Model": "",
      "Name": "ctxloom-init"
    },
    {
      "AllowedTools": null,
      "ArgumentHint": "",
      "Content": "blob:250eb05176d8be60b056237eb4d1ccf42ef1492fa060c8b2db31b1349f23abb4",
      "Description": "Discover and install profiles, bundles, and fragments",
      "Enabled": true,
      "Model": "",
      "Name": "discover"
    },
    {
      "AllowedTools": [
        "Read",
        "Grep"
      ],
      "ArgumentHint": "[path]",
      "Content": "Review the staged diff.\n",
      "Description": "Review the staged diff",
      "Enabled": true,
      "Model": "sonnet",
      "Name": "code-quality/review"
    },
    {
      "AllowedTools": null,
      "ArgumentHint": "",
      "Content": "Prepare the release notes.",
      "Description": "Release (disabled for claude)",
      "Enabled": false,
      "Model": "",
      "Name": "premised/release"
    }
  ],
  "DenyTools": null,
  "Hooks": {
    "unified": {
      "post_tool": [
        {
          "args": [
            "hook",
            "tool-reflect",
            "--min-output-bytes",
            "2048"
          ],
          "command": "ctxloom",
          "timeout": 5,
          "type": "command"
        },
        {
          "args": [
            "hook",
            "skill-mates"
          ],
          "command": "ctxloom",
          "matcher": "Skill",
          "timeout": 15,
          "type": "command"
        }
      ],
      "pre_tool": [
        {
          "_ctxloom": "bundle:ctxloom+local:code-quality",
          "async": true,
          "command": "audit-log record",
          "matcher": "Write",
          "type": "command"
        },
        {
          "_ctxloom": "bundle:ctxloom+local:code-quality",
          "command": "ltk guard",
          "matcher": "Bash",
          "timeout": 30,
          "type": "command"
        }
      ],
      "session_start": [
        {
          "_ctxloom": "bundle:ctxloom+local:code-quality",
          "pre_tool_fallback": true,
          "prompt": "Load the project context.",
          "type": "prompt"
        }
      ],
      "turn_end": [
        {
          "args": [
            "hook",
            "next-step"
          ],
          "command": "ctxloom",
          "timeout": 15,
          "type": "command"
        }
      ],
      "turn_start": [
        {
          "args": [
            "hook",
            "mail-drain"
          ],
          "command": "ctxloom",
          "timeout": 5,
          "type": "command"
        }
      ]
    }
  },
  "ManageStatusline": true,
  "Skills": [
    {
      "Description": "Review a change against the project's review checklist.",
      "Enabled": true,
      "Files": [
        {
          "Content": "blob:235fd9e4746922c1dbb12eaca3acf2420e5a14d24ebc209494c3f8bbc87b0747",
          "Mode": 420,
          "RelPath": "SKILL.md"
        },
        {
          "Content": "IyBDaGVja2xpc3QKCi0gRG9lcyBpdCBmYWlsIGxvdWRseT8K",
          "Mode": 420,
          "RelPath": "references/checklist.md"
        },
        {
          "Content": "IyEvYmluL3NoCmVjaG8gInJldmlld2luZyIK",
          "Mode": 493,
          "RelPath": "scripts/run.sh"
        }
      ],
      "Name": "code-reviewer"
    }
  ],
  "Surfaces": null
}
