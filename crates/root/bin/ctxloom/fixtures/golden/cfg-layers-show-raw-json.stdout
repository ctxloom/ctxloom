{
  "agents": {
    "home": {
      "llm": "claude-code",
      "profiles": [
        "h"
      ]
    },
    "proj": {
      "llm": "claude-code",
      "profiles": [
        "x"
      ]
    }
  },
  "companions": [
    "acme",
    "beta",
    "gamma"
  ],
  "editor": {
    "args": [
      "-h"
    ],
    "command": "project-editor"
  },
  "llm": {
    "defaults": {
      "fast": "claude-fast"
    }
  },
  "schema_version": 8,
  "workspace": "worktree"
}