hew-transforms: 1
target: target.yaml
format: yaml
transforms:
  - op: test
    path: /server/#0
    value:
      comment: ports below 1024 need CAP_NET_BIND_SERVICE
  - op: test
    path: /server/port
    value: 8080
  - op: test
    path: /server/timeout
    value: 30
  - op: replace
    path: /server/timeout
    value: 60
