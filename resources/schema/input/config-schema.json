{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$id": "https://ctxloom.dev/schemas/config.json",
  "title": "ctxloom Configuration",
  "description": "Schema for ctxloom config.yaml files",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "description": "Config schema version (integer; distinct from the application version)",
      "examples": [1, 2]
    },
    "llm": {
      "type": "object",
      "description": "Large language model configuration: a registry of arbitrarily-labeled backend configs plus a role→label map",
      "properties": {
        "configs": {
          "type": "object",
          "description": "Labeled backend configs. The map key is an arbitrary user label with zero semantics; the backend is determined solely by each entry's `type` field.",
          "additionalProperties": {
            "$ref": "#/$defs/llmConfig"
          }
        },
        "defaults": {
          "type": "object",
          "description": "Role → config-label map. Roles select which labeled config plays which part.",
          "properties": {
            "primary": {
              "type": "string",
              "description": "Label of the config for the coding/interactive role"
            },
            "fast": {
              "type": "string",
              "description": "Label of the config for the compression role (distill, compaction)"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "editor": {
      "type": "object",
      "description": "Editor configuration for fragment/prompt editing",
      "properties": {
        "command": {
          "type": "string",
          "description": "Editor command to use",
          "examples": ["vim", "nano", "code"]
        },
        "args": {
          "type": "array",
          "description": "Additional arguments for the editor",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "description": "Behavioral settings",
      "properties": {
        "use_distilled": {
          "type": "boolean",
          "description": "Whether to prefer distilled versions of fragments/prompts (default: true)"
        },
        "compaction_chunks": {
          "type": "integer",
          "description": "Target tokens per compaction chunk (default: 8000)"
        },
        "statusline": {
          "type": "boolean",
          "description": "Whether ctxloom manages its HUD statusline (default: true); set false to keep your own"
        }
      },
      "additionalProperties": false
    },
    "sync": {
      "type": "object",
      "description": "Remote dependency sync behavior",
      "properties": {
        "auto_sync": {
          "type": "boolean",
          "description": "Automatically sync remote dependencies on startup (default: true)"
        }
      },
      "additionalProperties": false
    },
    "hooks": {
      "$ref": "#/$defs/hooksConfig",
      "description": "Hooks configuration applied globally"
    },
    "mcp": {
      "type": "object",
      "description": "MCP (Model Context Protocol) server configuration",
      "properties": {
        "auto_register_ctxloom": {
          "type": "boolean",
          "description": "Whether to automatically register ctxloom's own MCP server (default: true)"
        },
        "servers": {
          "type": "object",
          "description": "Unified MCP server configurations (applied to all backends)",
          "additionalProperties": {
            "$ref": "#/$defs/mcpServer"
          }
        },
        "plugins": {
          "type": "object",
          "description": "Backend-specific MCP server configurations (keyed by backend name)",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/mcpServer"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "object",
      "description": "Profile defaults and named definitions",
      "properties": {
        "defaults": {
          "type": "array",
          "description": "Default profiles to load when none is specified",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "definitions": {
          "type": "object",
          "description": "Named collections of context fragments and variables",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "description": {
            "type": "string",
            "description": "Human-readable description of this profile"
          },
          "llm": {
            "type": "string",
            "description": "Preferred LLM config label/backend to launch for this profile (overridable by `run --llm`)"
          },
          "parents": {
            "type": "array",
            "description": "Parent profiles to inherit from (processed depth-first)",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "tags": {
            "type": "array",
            "description": "Fragment tags to include (fragments with matching tags are added)",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "fragments": {
            "type": "array",
            "description": "Explicit fragment paths to include",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "bundles": {
            "type": "array",
            "description": "Bundle references (e.g. remote/bundle-name)",
            "items": { "type": "string", "minLength": 1 }
          },
          "bundle_items": {
            "type": "array",
            "description": "Cherry-picked bundle items (e.g. remote/bundle:fragments/name)",
            "items": { "type": "string", "minLength": 1 }
          },
          "mcp": {
            "type": "object",
            "description": "MCP servers for this profile (inherited)"
          },
          "variables": {
            "type": "object",
            "description": "Variable values for template substitution in fragments",
            "additionalProperties": {
              "type": "string"
            }
          },
          "hooks": {
            "$ref": "#/$defs/hooksConfig",
            "description": "Hooks configuration for this profile (inherited from parents)"
          },
          "exclude_fragments": {
            "type": "array",
            "description": "Fragment names to exclude from this profile (filtered after inheritance)",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "exclude_prompts": {
            "type": "array",
            "description": "Prompt names to exclude from this profile (filtered after inheritance)",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "exclude_mcp": {
            "type": "array",
            "description": "MCP server names to exclude from this profile (filtered after inheritance)",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "llmConfig": {
      "type": "object",
      "description": "One labeled backend config. `type` is the discriminator; the remaining fields are that backend's own config.",
      "required": ["type"],
      "oneOf": [
        {
          "title": "claude-code",
          "properties": {
            "type": { "const": "claude-code" },
            "model": { "type": "string", "examples": ["opus", "sonnet", "haiku"] },
            "binary_path": { "type": "string" },
            "args": { "type": "array", "items": { "type": "string" } },
            "env": { "type": "object", "additionalProperties": { "type": "string" } }
          },
          "additionalProperties": false
        },
        {
          "title": "gemini",
          "properties": {
            "type": { "const": "gemini" },
            "model": { "type": "string", "examples": ["gemini-2.5-pro", "gemini-2.5-flash"] },
            "trust_workspace": { "type": "boolean" },
            "approval_mode": { "type": "string" },
            "binary_path": { "type": "string" },
            "args": { "type": "array", "items": { "type": "string" } },
            "env": { "type": "object", "additionalProperties": { "type": "string" } }
          },
          "additionalProperties": false
        },
        {
          "title": "codex",
          "properties": {
            "type": { "const": "codex" },
            "model": { "type": "string" },
            "binary_path": { "type": "string" },
            "args": { "type": "array", "items": { "type": "string" } },
            "env": { "type": "object", "additionalProperties": { "type": "string" } }
          },
          "additionalProperties": false
        },
        {
          "title": "mock",
          "properties": {
            "type": { "const": "mock" },
            "model": { "type": "string" },
            "env": { "type": "object", "additionalProperties": { "type": "string" } }
          },
          "additionalProperties": false
        }
      ]
    },
    "mcpServer": {
      "type": "object",
      "description": "MCP server configuration",
      "required": ["command"],
      "properties": {
        "command": {
          "type": "string",
          "description": "Command to run the MCP server",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "description": "Arguments for the server command",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "description": "Environment variables for the server",
          "additionalProperties": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string",
          "description": "Human-readable notes about the server (not sent to AI)"
        },
        "installation": {
          "type": "string",
          "description": "Setup/installation instructions (not sent to AI)"
        }
      },
      "additionalProperties": false
    },
    "hook": {
      "type": "object",
      "description": "A hook definition",
      "properties": {
        "matcher": {
          "type": "string",
          "description": "Regex pattern to filter when hook fires (by tool name, event source, etc.)"
        },
        "command": {
          "type": "string",
          "description": "Shell command to execute",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "description": "Hook handler type",
          "enum": ["command", "prompt", "agent"],
          "default": "command"
        },
        "prompt": {
          "type": "string",
          "description": "Prompt text for prompt/agent hook types"
        },
        "timeout": {
          "type": "integer",
          "description": "Execution timeout in seconds",
          "minimum": 1,
          "default": 30
        },
        "async": {
          "type": "boolean",
          "description": "Run hook in background (command hooks only)",
          "default": false
        }
      },
      "additionalProperties": true
    },
    "hookArray": {
      "type": "array",
      "description": "Array of hooks for an event",
      "items": {
        "$ref": "#/$defs/hook"
      }
    },
    "unifiedHooks": {
      "type": "object",
      "description": "Unified hook events (translated to backend-specific format)",
      "properties": {
        "pre_tool": {
          "$ref": "#/$defs/hookArray",
          "description": "Before tool execution"
        },
        "post_tool": {
          "$ref": "#/$defs/hookArray",
          "description": "After tool execution"
        },
        "session_start": {
          "$ref": "#/$defs/hookArray",
          "description": "When session starts"
        },
        "session_end": {
          "$ref": "#/$defs/hookArray",
          "description": "When session ends"
        },
        "pre_shell": {
          "$ref": "#/$defs/hookArray",
          "description": "Before shell command execution"
        },
        "post_file_edit": {
          "$ref": "#/$defs/hookArray",
          "description": "After file edit"
        }
      },
      "additionalProperties": false
    },
    "hooksConfig": {
      "type": "object",
      "description": "Hooks configuration",
      "properties": {
        "unified": {
          "$ref": "#/$defs/unifiedHooks",
          "description": "Unified hooks (translated per-backend)"
        },
        "plugins": {
          "type": "object",
          "description": "Backend-specific passthrough hooks (keyed by plugin name)",
          "additionalProperties": {
            "type": "object",
            "description": "Backend-native hook events",
            "additionalProperties": {
              "$ref": "#/$defs/hookArray"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
