# Messages for the crate's errors. Each id is an error's code, which begins with
# the crate's name; the variables are its args.

sessions-session-exists = session { $harp } already exists
sessions-no-session = there is no such session
sessions-harp-invalid = { $harp } cannot be a session name: { $reason }
sessions-name-malformed = { $name } is not a resource name: { $reason }
sessions-names-taken = the session name { $harp } is taken
sessions-project-name-taken = the project name { $harp } is another project's
sessions-project-not-named = the project { $project_id } has no name yet, so it cannot be registered
sessions-project-identity-changed = { $root } is not the repository registered as { $project }: its root commit is { $found_commit }, not { $registered_commit }
sessions-project-identity-changed-fix = put back the repository { $project } was registered with, or start a new project here: remove .ctxloom/project-id from { $root } if it is there, and { $root }'s entry from .ctxloom/projects/index.yaml in ctxloom's home (CTXLOOM_HOME, else your home), then run `ctxloom init` again
sessions-project-harp-mismatch = this directory is the project { $project }, not projects/{ $expected }
sessions-no-claim = nobody holds that session name
sessions-not-holder = this session does not hold the name { $harp }
sessions-not-owner = session { $requester } is not this session's owner, and only its owner may do that
sessions-session-closed = session { $harp } is closed: it takes no message, clear or new run
sessions-owner-closed = session { $harp } is closed, and a closed session launches no child
sessions-no-open-incarnation = session { $harp } has no run open to orchestrate a child
sessions-no-open-incarnation-fix = launch the child from the session's running agent
sessions-delegation-limit = this session holds { $open } open children, and its limit is { $limit }
sessions-delegation-limit-fix = close a child first, or raise the limit
sessions-untrusted-target = { $root } is another repository that has not passed the trust check
sessions-untrusted-target-fix = review and trust that repository's configuration first
sessions-urgency-unsupported = the session's engine cannot take a message of urgency { $urgency }
# DRAFT (the terminal wake, 2026-11-18).
sessions-wake-outstanding = a wake ({ $nonce }) is already outstanding: one at a time
sessions-session-unknown = there is no session named { $harp }
sessions-session-unknown-fix = list the sessions with `ctxloom session list`
sessions-session-destroyed = session { $harp } was removed, and cannot be resumed
sessions-session-destroyed-fix = start a new session with `ctxloom run`
sessions-session-running = session { $harp } is running, and cannot be resumed until it ends
sessions-session-running-fix = return to the session where it runs, or wait for it to end
sessions-no-native-session = session { $harp } has no engine session to resume: its engine never named one
sessions-no-native-session-fix = start a new session with `ctxloom run`
sessions-engine-mismatch = session { $harp } runs on { $engine }, and cannot be resumed on { $asked }
sessions-engine-mismatch-fix = resume it without `--engine`, or with `--engine { $engine }`
sessions-workspace-mismatch = session { $harp } works in workspace { $workspace }, and cannot be resumed in { $asked }: its engine keeps its conversation by where it works
sessions-workspace-mismatch-fix = resume it without `--workspace`, or with `--workspace { $workspace }`
sessions-rehost-budget-spent = session { $harp } was re-hosted { $recent } times in the last hour, and its limit is { $limit }: it is left ended
sessions-rehost-budget-spent-fix = find why its host keeps being lost, then resume it with `ctxloom run --session { $harp }`
sessions-session-live = refusing to remove { $harp }: it cannot be proven dead ({ $reason }). Nothing was removed.
sessions-session-live-fix = to destroy it anyway, deliberately: ctxloom session remove { $harp } --yes --even-if-live
sessions-session-lock-held = refusing to remove { $harp }: its lock { $lock } is held, and on Windows a directory holding an open file cannot be moved, so not even --even-if-live can remove it. Nothing was removed.
sessions-session-lock-held-fix = end the session first (exit its engine, or let its run finish), then: ctxloom session remove { $harp } --yes
sessions-session-kept = refusing to remove { $harp }: it is marked keep, so its transcript is kept at any age. Nothing was removed.
sessions-session-kept-fix = to release it: ctxloom session keep { $harp } --undo
sessions-within-retention = refusing to destroy { $harp }'s transcript, its record: the session ended within the transcript retention period ({ $detail }). Nothing was removed.
sessions-keeps-session = refusing to remove session { $harp }: { $spared } of its worktrees are spared and { $skipped } skipped, and a session is removed whole or not at all. Nothing was removed.
sessions-keeps-session-fix = commit or discard the work in each spared worktree, or wait for the session to end, then remove it again
