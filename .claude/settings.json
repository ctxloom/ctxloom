{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "ctxloom hook stamp-plan"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ctxloom hook session-bind"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ctxloom hook hud"
  }
}