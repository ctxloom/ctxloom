{
  "name": "ctxloom Development",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    // Dockerfile's tool-version ARGs are deliberately default-less (see
    // .devcontainer/tool-versions.env, the single source of truth for all of
    // them), so VS Code's own "Reopen in Container" build — which invokes
    // docker build directly, not `just dev-image` — needs these passed
    // explicitly too, or it fails the guard RUN. Keep this object's values
    // equal to tool-versions.env; internal/shared/buildpins' drift-gate test
    // (TestDevcontainerJSONBuildArgsMatchToolVersionsEnv) fails if they
    // diverge.
    "args": {
      "GO_VERSION": "1.26.9",
      "GO_SHA256_AMD64": "42d158b4d8f7b61ac0a830567c940a86098fb7aac52e467a5ebec03ef5cc2f8d",
      "GO_SHA256_ARM64": "4a97373d49fcacdcf3694fea368a500b00ee3e963974f3e7514132717632f052",
      "UPX_VERSION": "4.2.4",
      "ONNX_VERSION": "1.20.1",
      "GOLANGCI_LINT_VERSION": "2.12.1",
      "BUF_VERSION": "1.47.2",
      "PROTOC_GEN_GO_VERSION": "1.36.11",
      "PROTOC_GEN_GO_GRPC_VERSION": "1.6.2",
      "GOMUTANTS_VERSION": "0.7.0",
      "VERSIONATOR_VERSION": "0.2.3",
      "GORELEASER_VERSION": "2.16.0",
      "LIZARD_VERSION": "1.22.2",
      "JUST_VERSION": "1.40.0",
      "JUST_SHA256_AMD64": "181b91d0ceebe8a57723fb648ed2ce1a44d849438ce2e658339df4f8db5f1263",
      "JUST_SHA256_ARM64": "d065d0df1a1f99529869fba8a5b3e0a25c1795b9007099b00dfabe29c7c1f7b6",
      "GOPLS_VERSION": "0.21.0",
      "SERENA_AGENT_VERSION": "2.0.0",
      "GITLEAKS_VERSION": "8.30.1",
      "LEFTHOOK_VERSION": "1.13.6",
      "GOVULNCHECK_VERSION": "1.8.0",
      "NODE_VERSION": "24.21.0",
      "GIT_MIN_VERSION": "2.48.0"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "ms-vscode.makefile-tools"
      ],
      "settings": {
        "go.toolsManagement.autoUpdate": true,
        "go.useLanguageServer": true,
        "go.buildTags": "memory,vectors,onnx"
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "source=ctxloom-gomodcache,target=/go/pkg/mod,type=volume",
    "source=ctxloom-gobuildcache,target=/go/cache/build,type=volume"
  ],
  "workspaceFolder": "/workspace",
  "postCreateCommand": "go mod download",
  "remoteUser": "root",
  "containerEnv": {
    "CGO_ENABLED": "1"
  }
}
