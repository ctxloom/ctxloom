{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "ctxloom hook session-bind",
            "name": "ctxloom-managed",
            "type": "command"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "ctxloom": {
      "args": [
        "mcp"
      ],
      "command": "ctxloom"
    },
    "sequential-thinking": {
      "args": [
        "-y",
        "@anthropics/mcp-server-sequential-thinking"
      ],
      "command": "npx"
    }
  }
}
